<idea-plugin>
    <id>nl.cwi.swat.rascal-terminal</id>
    <name>Rascal Debugger</name>
    <vendor>cwi-swat</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.terminal</depends>
    <depends>org.jetbrains.plugins.textmate</depends>
    <depends>com.redhat.devtools.lsp4ij</depends>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="Rascal Terminal" displayType="BALLOON"/>
        <!--
          Bridges Rascal's `std:///` location scheme (baked into the compiled
          standard library, see org.rascalmpl.uri.StandardLibraryURIResolver)
          to IntelliJ's VFS. Without this, "Go to Definition" into stdlib
          symbols (IO::println, List::size, etc.) silently fails: LSP4IJ's
          UriConverterManager only handles file:/jar:/jrt:/WSL-UNC and falls
          back to VirtualFileManager.findFileByUrl for anything else, which
          has nothing registered for "std" until this extension point does.
        -->
        <virtualFileSystem implementationClass="nl.cwi.swat.rascalterminal.StdFileSystem" key="std" physical="true"/>
        <!--
          Makes Rascal's own |uri|(offset,length,<line,col>,<line,col>)
          location literals, printed for compile errors and stack traces in
          a "Run in new Rascal terminal" session, clickable: jumping to the
          right file and line/column. Reuses the same extension point the
          bundled Terminal plugin's own generic file-link detector uses
          (org.jetbrains.plugins.terminal.hyperlinks.filter
          .TerminalGenericFileFilterProvider), which otherwise misreads this
          syntax and shows "Cannot find file" instead of navigating. See
          RascalLocationLinkFilter's own javadoc for the full story.
        -->
        <consoleFilterProvider implementation="nl.cwi.swat.rascalterminal.RascalLocationLinkFilterProvider"/>
        <!--
          Registers the Rascal TextMate grammar automatically, so nobody
          has to register it with IntelliJ by hand. See
          RascalTextMateBundleProvider's own javadoc for why the grammar
          has to be extracted to a real directory rather than served
          straight out of this jar's own resources.
        -->
        <textmate.bundleProvider implementation="nl.cwi.swat.rascalterminal.RascalTextMateBundleProvider"/>
        <!--
          Auto-creates the "Rascal Attach" DAP Run/Debug configuration (see
          debugAdapterServer below) on project open, including the
          Mappings-tab entry that's easy to miss by hand, whose absence
          causes a completely silent breakpoint failure. See
          RascalProjectActivity's own javadoc for the full story.
        -->
        <postStartupActivity implementation="nl.cwi.swat.rascalterminal.RascalProjectActivity"/>
    </extensions>

    <extensions defaultExtensionNs="com.redhat.devtools.lsp4ij">
        <!--
          A distinct DAP server choice (selectable in a "Debug Adapter
          Protocol" run configuration's server dropdown, alongside LSP4IJ's
          built-in generic/"undefined" one) whose only real difference is
          RascalDebugAdapterDescriptor -> RascalBreakpointHandler, which
          fixes a real bug in LSP4IJ 0.21.0 (BreakpointHandlerBase
          .unregisterBreakpoint checks the whole project's breakpoint list
          for emptiness instead of just the affected file's, so disabling
          one breakpoint while any other is active anywhere else in the
          project never notifies the debug adapter,execution keeps
          stopping at a breakpoint you just disabled). See
          RascalBreakpointHandler's own javadoc for the full story.
          Selecting "Rascal Debugger" here (not the generic/"undefined"
          entry) is required to get this fix,see README.md.
        -->
        <debugAdapterServer id="rascal"
                             name="Rascal Debugger"
                             factoryClass="nl.cwi.swat.rascalterminal.RascalDebugAdapterDescriptorFactory"/>
        <!--
          Registers the .rsc Language Server automatically, so nobody has
          to manually add it via Settings > Languages & Frameworks >
          Language Servers. RascalLanguageServerFactory always resolves the
          classpath from whichever project is actually open (same as "Run
          in new Rascal terminal" already does). See its own javadoc for
          the full story.
        -->
        <server id="rascal-lsp"
                name="Rascal Language Server"
                factoryClass="nl.cwi.swat.rascalterminal.RascalLanguageServerFactory"/>
        <fileNamePatternMapping serverId="rascal-lsp" patterns="*.rsc" languageId="rascal"/>
        <!--
          rascal-lsp's language-parametric server, hosting every DSL
          registered from a "Rascal: ..." terminal via
          util::LanguageServer::registerLanguage (what the VS Code extension
          does with its own ParameterizedLanguageServer). Deliberately no
          file mappings here: RascalLanguageRegistry adds a *.<ext> mapping
          at runtime for each extension a REPL registers. See its own javadoc
          for the full story. lastDocumentDisconnectedTimeout (seconds):
          LSP4IJ's default of 5 would stop the server moments after the last
          DSL file closes, and every restart re-loads (re-interprets) each
          registered DSL from scratch.
        -->
        <server id="rascal-parametric"
                name="Rascal DSL Language Server (parametric)"
                lastDocumentDisconnectedTimeout="1800"
                factoryClass="nl.cwi.swat.rascalterminal.RascalParametricLanguageServerFactory"/>
    </extensions>

    <actions>
        <!--
          Rascal's LSP server (RascalLanguageServer, for .rsc) emits two
          CodeLenses, decompiled from
          org.rascalmpl.vscode.lsp.rascal.RascalLanguageServices
          #locateCodeLenses:
            - "Import in new Rascal terminal" above a module declaration,
              command "rascalmpl.importModule", one string argument: the
              module's qualified name as written in source.
            - "Run in new Rascal terminal" above a top-level function named
              main(), command "rascalmpl.runMain", same single argument
              (the enclosing module's qualified name, not the function
              itself).
          The action id below must match the command string verbatim; that
          is how LSP4IJ's LSPCommandAction dispatch works (see
          https://github.com/redhat-developer/lsp4ij/blob/main/docs/DeveloperGuide.md#lsp-commands).
          VS Code's own extension implements these itself; LSP4IJ has no
          built-in equivalent, which is why clicking these links in IntelliJ
          otherwise fails with "Cannot execute '...' command! ... needs to
          be contributed by an IntelliJ plugin."
        -->
        <action id="rascalmpl.importModule"
                class="nl.cwi.swat.rascalterminal.ImportModuleAction"/>
        <action id="rascalmpl.runMain"
                class="nl.cwi.swat.rascalterminal.RunMainAction"/>
    </actions>
</idea-plugin>
